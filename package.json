{
  "name": "@nocoo/kite",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "kite": "dist/cli.js"
  },
  "pi": {
    "extensions": [
      "./src/pi-extension.ts"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --error-on-warnings .",
    "test": "vitest run --coverage",
    "check": "npm run lint && npm run typecheck && npm test && node scripts/verify-coverage-summary.mjs",
    "l1:self-test": "node scripts/l1-hook-self-test.mjs",
    "prepare": "husky",
    "start": "node dist/cli.js serve",
    "dev": "vite",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "^5.1.0",
    "husky": "9.1.7",
    "typescript": "7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@nocoo/basalt": "3.2.1",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "overrides": {
    "source-map-js": "1.2.2"
  }
}
