{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "files": {
    "includes": [
      "src/**",
      "tests/**",
      "scripts/*.mjs",
      "*.json",
      "vitest.config.ts",
      "!package-lock.json",
      "!!reference",
      "!!node_modules",
      "!!dist",
      "web/**",
      "vite.config.ts"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 110
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noFocusedTests": "error",
        "noSkippedTests": "error"
      }
    }
  }
}
